{
  "name": "zyra",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.15",
  "workspaces": [
    "apps/code-worker",
    "packages/runtime/claude-runtime",
    "packages/integrations/claude-mcp",
    "packages/runtime/sandbox-gateway-control",
    "packages/runtime/runtime-event-spine"
  ],
  "scripts": {
    "typecheck": "tsc -p packages/runtime/claude-runtime/tsconfig.json && tsc -p packages/runtime/runtime-event-spine/tsconfig.json",
    "typecheck:e01": "tsc -p packages/runtime/claude-runtime/tsconfig.json",
    "build": "bun run build:bun && bun run build:node",
    "build:bun": "bun build apps/code-worker/src/main.ts --outdir dist/code-worker --target bun",
    "build:node": "bun build apps/code-worker/src/main.ts --outdir dist/code-worker-node --target node",
    "runtime:health": "bun apps/code-worker/src/main.ts --health",
    "runtime:built:health": "bun run runtime:built:bun:health && bun run runtime:built:node:health",
    "runtime:built:bun:health": "bun dist/code-worker/main.js --health",
    "runtime:built:node:health": "node dist/code-worker-node/main.js --health",
    "runtime:test": "bun test packages/runtime/claude-runtime/test/protocol.test.ts packages/runtime/claude-runtime/test/runtime.test.ts packages/runtime/claude-runtime/test/e01",
    "runtime:e01:test": "bun test packages/runtime/claude-runtime/test/e01 packages/runtime/claude-runtime/test/runtime.test.ts",
    "e01:gate": "bun scripts/remediation/verify_m1_r01_e01_v4.ts",
    "e01:candidate:gate": "bun scripts/remediation/verify_m1_r01_e01_v4.ts --output docs/reviews/evidence/M1-R01-v3/execution-01/candidate-gate-result.json",
    "e01:probe:runtime-origin": "bun scripts/remediation/probe_m1_r01_e01.ts runtime-origin",
    "e01:probe:write-path": "bun scripts/remediation/probe_m1_r01_e01.ts write-path",
    "e01:probe:resume": "bun scripts/remediation/probe_m1_r01_e01.ts resume",
    "e01:probe:lost-ack": "bun scripts/remediation/probe_m1_r01_e01.ts lost-ack",
    "e01:probe:disable": "bun scripts/remediation/probe_m1_r01_e01.ts disable",
    "e01:mutation": "bun scripts/remediation/run_m1_r01_e01_mutations.ts",
    "e01:audit:dependencies": "bun scripts/remediation/probe_m1_r01_e01.ts dependencies",
    "e01:toolchain": "bun scripts/remediation/probe_m1_r01_e01.ts toolchain",
    "e01:cleanroom": "bun scripts/remediation/probe_m1_r01_e01.ts cleanroom"
  },
  "devDependencies": {
    "@types/bun": "1.2.15",
    "@types/node": "22.15.29",
    "bun": "1.2.15",
    "typescript": "5.8.3"
  }
}
