    "runtime:e01:test": "node --experimental-strip-types --test packages/runtime/claude-runtime/test/e01/runtime-core.behavior.test.ts packages/runtime/claude-runtime/test/e01/crash-matrix.behavior.test.ts"
  },
  "devDependencies": {
    "@types/node": "22.15.29",
    "typescript": "5.8.3"
