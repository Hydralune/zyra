ZYRA_ENV=development
ZYRA_API_HOST=127.0.0.1
ZYRA_API_PORT=8000
ZYRA_WEB_HOST=127.0.0.1
ZYRA_WEB_PORT=5173
ZYRA_EVENT_LOG=tmp/events.jsonl
ZYRA_SQLITE_PATH=tmp/zyra.sqlite3
ZYRA_TOOL_WORKSPACE=tmp/workspace
ZYRA_ARTIFACT_ROOT=tmp/artifacts
ZYRA_PERMISSION_STORE=tmp/permissions.json

# Optional real-provider smoke configuration. Keep real values in
# .env.deepseek.local, .env.kimi.local, or .env.glm.local; all are ignored by Git.
DEEPSEEK_API_KEY=replace-with-local-secret
ZAI_API_KEY=replace-with-local-secret
KIMI_API_KEY=replace-with-local-secret
# Provider profiles default to enabled when the switch is absent. Disable a
# profile to retain its credential/configuration without admitting it to routes.
ZYRA_DEEPSEEK_ENABLED=true
ZYRA_GLM_ENABLED=false
ZYRA_KIMI_ENABLED=false
ZYRA_MODEL_PROVIDER=deepseek
ZYRA_MODEL=deepseek-v4-flash
